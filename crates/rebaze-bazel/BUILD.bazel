load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "rebaze-bazel",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/rebaze-bcr",
        "//crates/rebaze-cmake",
        "//crates/rebaze-gradle",
        "//crates/rebaze-starlark",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "rebaze-bazel_test",
    crate = ":rebaze-bazel",
)
