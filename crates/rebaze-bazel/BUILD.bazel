load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

rust_library(
    name = "rebaze-bazel",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "//:rebaze.example.toml",
        "//:docs/src/content/docs/reference/config.mdx",
    ] + glob([
        "src/templates/*.bzl",
        "tests/fixtures/managed_dependency/*",
    ]),
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/rebaze-bcr",
        "//crates/rebaze-cmake",
        "//crates/rebaze-gradle",
        "//crates/rebaze-starlark",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "rebaze-bazel_test",
    crate = ":rebaze-bazel",
    deps = ["@crates//:starlark_syntax"],
)
