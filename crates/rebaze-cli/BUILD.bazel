load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

rust_binary(
    name = "rebaze",
    srcs = ["src/main.rs"],
    edition = "2024",
    visibility = ["//visibility:public"],
    deps = [
        "//crates/rebaze-bazel",
        "//crates/rebaze-core",
        "//crates/rebaze-gradle",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:colored",
        "@crates//:indicatif",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
    ],
)

rust_test(
    name = "rebaze_test",
    crate = ":rebaze",
    edition = "2024",
)
